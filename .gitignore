# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Raw vendor data lives outside the repo (see src/volbt/config.py) and is never committed.
# "/data/" is anchored to the repo root so it cannot hide app/src/data/ or app/public/data/.
/data/
/runs/
*.parquet
*.duckdb
# ...except the tiny SYNTHETIC fixtures (20 rows each, made-up values), which the schema-pin tests read.
!/tests/fixtures/*.parquet

# Secrets
.env
.env.*

# Node / front-end build output
node_modules/
dist/
coverage/

# Tooling output
graphify-out/

# OS
.DS_Store
