flowchart TB
    subgraph sources["Vendor sources (outside the repo)"]
        src_optionsdx(["Kaggle OptionsDX SPY EOD 2010-2023\n14 parquet files, 9,468,584 rows, 16#58;00 ET snapshots"])
        src_dolthub(["DoltHub option_chain SPY 2019-2026\nShared dolt clone, never queried; no volume, sizes or underlying"])
        src_yf{{"yfinance SPY bars and dividends\nUnadjusted close, auto_adjust=False"}}
        src_fred{{"FRED DGS3MO\n3-month constant-maturity yield, investment basis"}}
        src_cboe{{"Cboe VIX history CSV"}}
    end
    subgraph store["Chain store (M1)"]
        st_vendor[("Vendor sources in #36;VOL_DATA_DIR\nRead only, never modified. DoltHub#58; private mirror at #36;VOL_DATA_DIR/vol-strategy-backtester/cache/dolt_mirror/options")]
        st_raw[("Downloads in repo data/raw/\nwork_dir(), git-ignored, never committed")]
        p_data["volbt.data#58; load, calendar, quality flags\nSchema pin; long format; OSI symbols; flag rather than drop"]
        st_clean[("Clean parquet + DuckDB\nBuilt in M1, in repo data/store/#58; option_quotes, calendar_actions, spy_bars, rates, dividends, vix, vix3m, chain_mask and the quality and cross-vendor tables")]
    end
    subgraph core["Pricing and signals (M2, M4)"]
        p_pricing["volbt.pricing#58; Black-76, IV, parity forward, CRR lattice, smile\nPure functions, no I/O; imports no volbt module (ADR-0001, ADR-0008)"]
        p_build["volbt.build#58; pricing build\nReads and writes through volbt.data, calls volbt.pricing; de-Americanises quotes (ADR-0001, ADR-0008)"]
        st_derived[("Derived tables#58; quote_iv, expiry_forwards, smile_fits")]
        p_signals["volbt.signals#58; RV, HAR/GARCH, IV30, VRP spread\nCausal#58; called each session with the MarketView; monthly refits on data up to t (ADR-0001)"]
    end
    subgraph sim["Simulation (M3 to M5)"]
        p_view["MarketView as_of t\nProtocol in volbt.view, implemented in volbt.data; LookAheadError after t, SplitError past the split end"]
        p_strat["volbt.strategies#58; structures, entry and exit rules"]
        p_risk["volbt.risk#58; greek and stress budgets, sizing, margin\nADR-0006 (greeks, stress grid cells), ADR-0007 (net margin requirement)"]
        p_engine["volbt.engine#58; daily loop, fills, marks, expiry, hedge\nADR-0002 to ADR-0005"]
        st_ledger[("Run ledger parquet under runs/run_id")]
    end
    subgraph results["Analytics and export (M6)"]
        p_analytics["volbt.analytics#58; metrics, attribution, regimes, stress grid\nReads ledger tables only (ADR-0010)"]
        p_export["volbt.export + tools/export_app_data.py\nJSON Schema validation before write"]
        a_json[/"app/public/data JSON#58; manifest + datasets\nEnvelope#58; schema_version, generated_at, source_commit"/]
    end
    subgraph app["App (visualises only)"]
        ui_app("Vite + React 19 + three.js viewer\nParses, validates and renders; never computes a result")
    end
