          <mxGeometry x="1503" y="770" width="396" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_s_pricing_summary" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#B45309&quot;&gt;&lt;b&gt;STORE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;pricing_summary.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Headline numbers by source, year and tenor, read back from the stored tables; no clock time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_features">
          <mxGeometry x="1111" y="1016" width="616" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_f_export_sf" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;tools/export_app_data.py: surface_frames.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;IVs of a few labelled dates on a fixed grid, read off the smiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_features">
          <mxGeometry x="1767" y="1016" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_e_run" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;tools/run_backtest.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Builds the RunConfig and the strategy; passes the commit and build.require_current to the engine; --for-app records the run for the app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="2035" y="50" width="862" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_e_cache" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;YearCache: the pricing tables a year at a time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;option_quotes, quote_iv, expiry_forwards, smile_fits of one source, two years in memory; reference tables whole. Only a view slices it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="1155" y="50" width="854" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_e_view" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;StoreView as_of t, one per session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Built in M1; M3 adds quotes, quote_ivs, forwards and smiles. LookAheadError after t; SplitError past the split end; the engine's own reads use it too&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="1117" y="254" width="934" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_e_sig" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Signals from the view: RV, HAR/GARCH, IV30 minus RV forecast (planned, M4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Causal; expanding window from 2000, refit monthly on data up to t (ADR-0001)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="506" y="414" width="650" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_e_strat" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;RollingShortStraddle (reference strategy)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;A diagnostic that exercises the engine, not a result: sells ATM straddles on the monthly expiry nearest 30 days, closes when DTE at the next session is 7 or less&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="1196" y="414" width="1010" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_e_loop" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;volbt.engine.loop.run_backtest: eleven steps per session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Load, start of day, fills, settlement, marks, hedge, daily_pnl, risk (ruin only), decide, early exercise, write. Steps in engine_daily_loop_sequence.mmd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="1253" y="610" width="942" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node_s_ledger" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#B45309&quot;&gt;&lt;b&gt;STORE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ledger: runs, positions, orders, order_legs, fills, lots, position_marks, hedges, expiry_events, risk_events, daily_pnl, cash_flows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;One parquet file per table in work_dir()/runs/run_id=ID/ (the id is the folder name), written once, plus run_meta.json. signals (M4) and greeks_snapshots (M5) are planned&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_simulation">
          <mxGeometry x="1191" y="758" width="1066" height="70" as="geometry"/>
        </mxCell>
