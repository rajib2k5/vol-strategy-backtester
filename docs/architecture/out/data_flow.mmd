    e_view -->|"one session"| e_loop
    e_loop -->|"append rows"| s_ledger
    s_ledger -->|"daily_pnl"| r_metrics
    s_ledger -->|"position_marks"| r_attr
    s_ledger -->|"lots at as_of"| r_grid
    r_metrics -->|"metrics"| r_export
    r_attr -->|"pnl_attribution"| r_export
    r_grid -->|"stress_grid"| r_export
    s_iv -->|"surface_frames"| r_export
