---
title: "Data flow from vendor files to the app"
---
flowchart TB
    subgraph vendors["Vendors"]
        v_optionsdx(["raw_optionsdx_eod\n33 bracketed columns, one wide row per date, expiry, strike; read in place from #36;VOL_DATA_DIR"])
        v_dolthub(["raw_dolthub_option_chain\n13 columns; queried through a private mirror in #36;VOL_DATA_DIR, never the shared clone; SPY rows exported once"])
        v_yf{{"yfinance SPY OHLC + dividends"}}
        v_fred{{"FRED DGS3MO"}}
        v_cboe{{"Cboe VIX and VIX3M\nVIX3M is available#58; 4,304 rows"}}
    end
    subgraph ingest["Ingest and clean (M1, built)"]
        i_ref["Fetch and parse reference series\ntools/build_data.py --fetch downloads into the repo's data/raw/; yfinance with auto_adjust=False"]
        s_ref[("spy_bars, rates, dividends, vix, vix3m")]
        i_cal["Date map from SPY bars\ncalendar_actions#58; keep each session, drop every other vendor date; never from chain dates (OptionsDX#58; 12 closure dates, all dropped)"]
        i_load["Load chains + pin schema\nOptionsDX parquet from #36;VOL_DATA_DIR and the exported DoltHub rows from data/raw/; a changed column stops the build"]
        i_flags["Reshape long, OSI symbol, quality_flags\n13-bit bitmask in ADR-0009; rows are flagged, only calendar drops are deleted"]
        s_quality[("quality_flag_counts, quality_calendar, quality_underlying, quality_rows_per_date, quality_non_session_dates\nThe report; written even when the gate fails, so a failure can be read")]
        g_quality["Quality gate passed?\nLimits set after looking at the data; a failure raises QualityGateError and deletes any old option_quotes"]
        s_quotes[("option_quotes, calendar_actions\n19,022,008 quotes, partitioned by source and year, in the repo's data/store/")]
        i_mask["DoltHub sampling mask for surface-gap runs\nchain_mask#58; the expiry and strike pairs DoltHub lists per date (dolthub), and with Tue/Thu carried forward (dolthub_daily)"]
        i_xvendor["Cross-vendor check, 2020-2023\n30-day ATM IV and parity-implied SPY price on the 572 dates both vendors list; reports the share of dates inside each threshold, with no verdict"]
        s_xvendor[("cross_vendor_overlap, cross_vendor_previous_session")]
        s_summary[("build_summary.json\nCounts, quantiles, shares inside the cross-vendor thresholds and the gate result; no clock time")]
        i_export_dq["tools/export_app_data.py#58; data_quality.json\nAggregates only#58; flag counts per year, rows per source, calendar fixes, cross-vendor quantiles, gate limits"]
    end
    subgraph features["Pricing build (M2, planned)"]
        f_forward["Parity forward per expiry, de-Americanised\nCRR early-exercise premium removed from 10 near-K* pairs, then median F_K over 5 strikes near K* (ADR-0008)"]
        f_iv["IV solve on de-Americanised OTM mids\nPremium removed within |k| 0.15; Newton then bisection"]
        f_smile["Smile nodes in total variance\nWing, cross-expiry and tenor rules applied at mark time (ADR-0004)"]
        s_iv[("expiry_forwards, quote_iv, smile_fits")]
    end
    subgraph simulation["Simulation (M3 to M5, planned)"]
        e_view["MarketView as_of t\nBuilt in M1 (StoreView)#58; LookAheadError after t; SplitError past the split end"]
        e_sig["Signals from the view#58; RV, HAR/GARCH, IV30 minus RV forecast\nCausal; expanding window from 2000, refit monthly on data up to t (ADR-0001)"]
        e_loop["Daily loop#58; fills, expiry, marks, hedge, risk, orders\nOrder of steps in engine_daily_loop_sequence.mmd"]
        s_ledger[("runs, signals, orders, order_legs, fills, positions, lots, position_marks, hedges, expiry_events, risk_events, greeks_snapshots, daily_pnl")]
    end
    subgraph results["Results (M6, planned)"]
        r_metrics["Metrics, PSR/DSR, regimes, stress windows"]
        r_attr["Greek P#38;L attribution"]
        r_grid["Spot x vol stress grid\nFull revaluation"]
        r_export["Export + JSON Schema validation"]
    end
    subgraph presentation["Presentation (app built in M0)"]
        a_json[/"manifest.json + dataset JSON files\nWritten today#58; manifest, illustrative_surface (M0), data_quality (M1). The M2 to M6 datasets are planned"/]
        u_app("React app renders")
    end
    v_yf -->|"OHLC, dividends"| i_ref
    v_fred -->|"yield, percent"| i_ref
    v_cboe -->|"daily closes"| i_ref
    i_ref -->|"typed tables"| s_ref
    s_ref -->|"SPY sessions"| i_cal
    v_optionsdx -->|"parquet, read in place"| i_load
    v_dolthub -->|"SELECT on the mirror, exported to data/raw/"| i_load
    i_load -->|"wide rows"| i_flags
    i_cal -->|"session check, non-session dates dropped"| i_flags
    s_ref -->|"SPY close for UNDERLYING_MISMATCH"| i_flags
    i_flags -->|"report tables"| s_quality
    s_quality -->|"limits checked"| g_quality
    g_quality -->|"pass#58; write"| s_quotes
    g_quality -->|"fail#58; stop, fix loader"| i_load
    g_quality -->|"gate result"| s_summary
    s_quotes -->|"call and put mids"| f_forward
    s_ref -->|"r_cc, dividends"| f_forward
    f_forward -->|"F, DF, tau"| f_iv
    s_quotes -->|"OTM mids"| f_iv
    f_iv -->|"IV by strike"| f_smile
    f_smile -->|"derived tables"| s_iv
    f_forward -->|"forwards"| s_iv
    s_quotes -->|"quotes for t"| e_view
    s_quotes -->|"DoltHub's listed pairs"| i_mask
    s_quotes -->|"both vendors' rows, 2020-2023"| i_xvendor
    s_ref -->|"SPY bars, rates, dividends"| i_xvendor
    i_xvendor -->|"overlap and hypothesis test"| s_xvendor
    i_xvendor -->|"quantiles, shares within thresholds"| s_summary
    s_quality -->|"flag counts, calendar, rows per date"| i_export_dq
    s_summary -->|"cross-vendor quantiles, gate result"| i_export_dq
    i_export_dq -->|"write data_quality.json"| a_json
    i_mask -->|"planned#58; the view does not serve chain_mask yet"| e_view
    s_iv -->|"surface for t"| e_view
    s_ref -->|"SPY bars, rates, VIX"| e_view
    e_view -->|"SPY bars, VIX, surface up to t"| e_sig
